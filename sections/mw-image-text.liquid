{{ 'mw-content.css' | asset_url | stylesheet_tag }}

<section class="mw mw-section mw-content" style="{% render 'mw-section-style', section: section %}">
  <div class="mw-container">
    <div
      class="mw-image-text mw-image-text--{{ section.settings.image_position }}{% if section.settings.card %} mw-card-surface{% endif %}"
      style="--mw-media-ratio: {{ section.settings.image_ratio }};"
    >
      <span class="mw-media mw-image-text__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              widths: '500, 800, 1100, 1400, 1800',
              sizes: '(min-width: 750px) 50vw, 100vw'
          }}
        {%- endif -%}
      </span>

      <div class="mw-image-text__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              {%- if block.settings.text != blank -%}
                <p class="mw-eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
              {%- endif -%}
            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="mw-heading mw-heading--{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
              {%- endif -%}
            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="mw-body" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- endif -%}
            {%- when 'button' -%}
              {%- if block.settings.button_label != blank -%}
                <div class="mw-buttons" {{ block.shopify_attributes }}>
                  {%- if block.settings.button_style == 'link' -%}
                    <a href="{{ block.settings.button_link | default: '#' }}" class="mw-arrow-link">
                      <span>{{ block.settings.button_label | escape }}</span>
                      {% render 'mw-icon', name: 'arrow-right' %}
                    </a>
                  {%- else -%}
                    <a href="{{ block.settings.button_link | default: '#' }}" class="mw-button{% if block.settings.button_style == 'secondary' %} mw-button--secondary{% endif %}">
                      {{- block.settings.button_label | escape -}}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Meldwood image + text",
  "tag": "div",
  "class": "mw-image-text-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "1",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "4 / 3", "label": "Landscape" }
      ]
    },
    { "type": "checkbox", "id": "card", "default": false, "label": "Show on a card" },
    { "type": "header", "content": "Section style" },
    { "type": "color", "id": "section_bg", "label": "Background", "info": "Leave empty to use the theme color." },
    { "type": "range", "id": "space_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Extra space above" },
    { "type": "range", "id": "space_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Extra space below" }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "default": "Our story", "label": "Text" }]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "default": "Image with text", "label": "Heading" },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "default": "large",
          "options": [
            { "value": "display", "label": "Display" },
            { "value": "large", "label": "Large" },
            { "value": "medium", "label": "Medium" }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "default": "<p>Pair text with an image to tell your story.</p>", "label": "Text" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "button_label", "default": "Learn more", "label": "Label" },
        { "type": "url", "id": "button_link", "label": "Link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Style",
          "default": "primary",
          "options": [
            { "value": "primary", "label": "Dark button" },
            { "value": "secondary", "label": "White button" },
            { "value": "link", "label": "Text link with arrow" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Meldwood image + text",
      "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }]
    }
  ]
}
{% endschema %}

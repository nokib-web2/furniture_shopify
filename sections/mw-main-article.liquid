{{ 'mw-content.css' | asset_url | stylesheet_tag }}

<section
  class="mw mw-section mw-content"
  style="{% render 'mw-section-style', section: section %} --mw-text-width: {{ section.settings.max_width }};"
>
  <article class="mw-container mw-content__inner">
    <div class="mw-page-header mw-page-header--center">
      {%- if section.settings.back_label != blank -%}
        <a href="{{ blog.url }}" class="mw-article__back">← {{ section.settings.back_label | escape }} {{ blog.title | escape }}</a>
      {%- endif -%}
      {%- if section.settings.show_date -%}
        <p class="mw-eyebrow">
          {{ article.published_at | time_tag: format: 'date' }}
          {%- if section.settings.show_author and article.author != blank %} · {{ article.author | escape }}{% endif -%}
        </p>
      {%- endif -%}
      <h1 class="mw-heading mw-heading--display">{{ article.title | escape }}</h1>
    </div>

    {%- if article.image and section.settings.show_image -%}
      <span class="mw-media mw-article__hero">
        {{
          article.image
          | image_url: width: 2400
          | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: article.image.alt
        }}
      </span>
    {%- endif -%}

    <div class="mw-page-body mw-page-body--center mw-rte">
      {{ article.content }}
    </div>

    {%- if article.tags.size > 0 or section.settings.show_share -%}
      <div class="mw-page-body mw-page-body--center mw-article__footer" style="width: 100%;">
        {%- if article.tags.size > 0 -%}
          <div class="mw-tags">
            {%- for tag in article.tags -%}
              <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="mw-tag-pill">{{ tag | escape }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if section.settings.show_share -%}
          <div class="mw-share">
            <span>{{ section.settings.share_label | escape }}</span>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ request.origin | append: article.url | url_encode }}" target="_blank" rel="noopener" aria-label="Facebook">
              {% render 'mw-icon', name: 'facebook' %}
            </a>
            <a href="{{ settings.social_instagram_link | default: '#' }}" target="_blank" rel="noopener" aria-label="Instagram">
              {% render 'mw-icon', name: 'instagram' %}
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </article>
</section>

{% schema %}
{
  "name": "Meldwood article",
  "tag": "div",
  "class": "mw-main-article-section",
  "settings": [
    { "type": "text", "id": "back_label", "default": "Back to", "label": "Back link label", "info": "Shown before the blog name. Leave empty to hide." },
    { "type": "checkbox", "id": "show_date", "default": true, "label": "Show date" },
    { "type": "checkbox", "id": "show_author", "default": false, "label": "Show author" },
    { "type": "checkbox", "id": "show_image", "default": true, "label": "Show featured image" },
    { "type": "checkbox", "id": "show_share", "default": true, "label": "Show share links" },
    { "type": "text", "id": "share_label", "default": "Share", "label": "Share label" },
    { "type": "range", "id": "max_width", "min": 600, "max": 1400, "step": 10, "unit": "px", "default": 880, "label": "Text width (desktop)" },
    { "type": "header", "content": "Section style" },
    { "type": "color", "id": "section_bg", "label": "Background", "info": "Leave empty to use the theme color." },
    { "type": "range", "id": "space_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Extra space above" },
    { "type": "range", "id": "space_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Extra space below" }
  ]
}
{% endschema %}

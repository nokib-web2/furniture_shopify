{{ 'mw-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mw-landing.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign menu = section.settings.menu
  assign overlay = false
  if section.settings.overlay_home and template.name == 'index'
    assign overlay = true
  elsif section.settings.overlay_collection and template.name == 'collection'
    assign overlay = true
  endif
-%}

{%- assign logo_image = section.settings.logo | default: settings.logo -%}
<header style="--mw-logo-w: {{ section.settings.logo_width | default: 248 }};" class="mw mw-header{% if overlay %} mw-header--overlay{% endif %}{% unless template.name == 'index' %} mw-header--page{% endunless %}">
  <div class="mw-header__inner">
    <details class="mw-header__drawer" data-mw-dismissable>
      <summary class="mw-header__menu-btn" aria-label="{{ 'sections.header.menu' | t }}">
        {% render 'mw-icon', name: 'menu', class: 'mw-header__menu-icon mw-header__menu-icon--tablet' %}
        {% render 'mw-icon', name: 'menu-outlined', class: 'mw-header__menu-icon mw-header__menu-icon--mobile' %}
      </summary>
      <nav class="mw-header__drawer-panel" aria-label="{{ 'sections.header.menu' | t }}">
        <ul>
          {%- for link in menu.links -%}
            <li>
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {%- if link.links != blank -%}
                <ul class="mw-header__drawer-sub">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
          {%- if section.settings.contact_label != blank -%}
            <li>
              <a href="{{ section.settings.contact_link | default: '#' }}">{{ section.settings.contact_label | escape }}</a>
            </li>
          {%- endif -%}
        </ul>
      </nav>
    </details>

    <a href="{{ routes.root_url }}" class="mw-header__logo">
      {%- if logo_image != blank -%}
        {{
          logo_image
          | image_url: width: 600
          | image_tag: class: 'mw-header__logo-img', alt: shop.name, widths: '200, 300, 400, 600', sizes: '248px'
        }}
      {%- else -%}
        <img
          src="{{ 'mw-logo.svg' | asset_url }}"
          alt="{{ shop.name | escape }}"
          class="mw-header__logo-img"
          width="155"
          height="14"
        >
      {%- endif -%}
    </a>

    <nav class="mw-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="mw-header__nav-list">
        {%- for link in menu.links -%}
          {%- if link.links != blank -%}
            <li class="mw-header__nav-item">
              <details class="mw-header__dropdown" data-mw-dismissable>
                <summary class="mw-header__nav-link{% if link.child_active %} is-active{% endif %}">
                  <span>{{ link.title | escape }}</span>
                  {% render 'mw-icon', name: 'caret-down', class: 'mw-header__caret' %}
                </summary>
                <ul class="mw-header__submenu">
                  {%- for child in link.links -%}
                    <li>
                      <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>
                        {{- child.title | escape -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            </li>
          {%- else -%}
            <li class="mw-header__nav-item">
              <a
                href="{{ link.url }}"
                class="mw-header__nav-link{% if link.current %} is-active{% endif %}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="mw-header__actions">
      <a href="{{ routes.cart_url }}" class="mw-header__cart" aria-label="{{ 'templates.cart.cart' | t }}">
        {% render 'mw-icon', name: 'cart', class: 'mw-header__cart-icon' %}
      </a>
      {%- if section.settings.contact_label != blank -%}
        <a href="{{ section.settings.contact_link | default: '#' }}" class="mw-header__contact">
          <span class="mw-header__contact-text mw-header__contact-text--desktop">
            {{- section.settings.contact_label | escape -}}
          </span>
          <span class="mw-header__contact-text mw-header__contact-text--tablet">
            {{- section.settings.contact_label_tablet | default: section.settings.contact_label | escape -}}
          </span>
          <span class="mw-header__contact-arrow">
            <span class="mw-header__contact-circle">
              {% render 'mw-icon', name: 'arrow-up-white' %}
            </span>
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Meldwood header",
  "class": "mw-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to use Theme settings → Logo, then the Meldwood wordmark."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 248,
      "label": "Logo width (desktop)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu",
      "info": "Menu items with sub-items show a dropdown."
    },
    {
      "type": "text",
      "id": "contact_label",
      "default": "Contact us",
      "label": "Contact button label"
    },
    {
      "type": "text",
      "id": "contact_label_tablet",
      "default": "Contact",
      "label": "Contact button label on tablet"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact button link"
    },
    {
      "type": "checkbox",
      "id": "overlay_home",
      "default": true,
      "label": "Overlay header on the homepage hero (desktop)"
    },
    {
      "type": "checkbox",
      "id": "overlay_collection",
      "default": true,
      "label": "Overlay header on the shop hero (desktop)"
    }
  ]
}
{% endschema %}

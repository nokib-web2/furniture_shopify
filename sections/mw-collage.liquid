{{ 'mw-content.css' | asset_url | stylesheet_tag }}

{%- assign images = section.blocks | where: 'type', 'image' -%}

<section class="mw mw-section mw-content" style="{% render 'mw-section-style', section: section %}">
  <div class="mw-container mw-content__inner">
    {%- if section.settings.heading != blank -%}
      <div class="mw-columns__header mw-columns__header--center">
        <h2 class="mw-heading mw-heading--large">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="mw-collage mw-collage--count-{{ images.size | at_most: 3 }}">
      {%- for block in images limit: 3 -%}
        <span class="mw-media mw-collage__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                widths: '500, 800, 1100, 1400, 1800',
                sizes: '(min-width: 750px) 55vw, 100vw',
                alt: block.settings.image.alt
            }}
          {%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Meldwood collage",
  "tag": "div",
  "class": "mw-collage-section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "header", "content": "Section style" },
    { "type": "color", "id": "section_bg", "label": "Background", "info": "Leave empty to use the theme color." },
    { "type": "range", "id": "space_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Extra space above" },
    { "type": "range", "id": "space_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Extra space below" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 3,
      "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }]
    }
  ],
  "presets": [
    {
      "name": "Meldwood collage",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}

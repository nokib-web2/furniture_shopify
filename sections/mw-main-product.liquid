{{ 'mw-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mw-product.js' | asset_url }}" defer="defer"></script>
{%- assign tutorial_blocks = section.blocks | where: 'type', 'tutorial_link' -%}
{%- if tutorial_blocks.size > 0 -%}
  {{ 'mw-tutorials.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'mw-video.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign featured_media_id = variant.featured_media.id | default: product.featured_media.id
-%}

<section
  class="mw mw-section mw-product"
  id="MwProduct-{{ section.id }}"
  style="{% render 'mw-section-style', section: section %} --mw-media-fit: {{ section.settings.media_fit | default: 'contain' }}; --mw-thumb-fit: {{ section.settings.thumb_fit | default: 'contain' }}; --mw-media-h: {{ section.settings.media_height | default: 480 }};"
>
  <mw-product class="mw-product__inner" data-url="{{ product.url }}">
    <div class="mw-product__gallery{% if section.settings.media_backdrop == 'blur' %} mw-product__gallery--blur{% endif %}">
      <div class="mw-product__main">
        {%- for media in product.media -%}
          <div
            class="mw-product__slide"
            data-media-id="{{ media.id }}"
            {% unless media.id == featured_media_id %}
              hidden
            {% endunless %}
          >
            {%- if section.settings.media_backdrop == 'blur' -%}
              {{ media.preview_image | image_url: width: 160 | image_tag: class: 'mw-product__backdrop', loading: 'lazy', alt: '', aria-hidden: 'true' }}
            {%- endif -%}
            {{
              media.preview_image
              | image_url: width: 2400
              | image_tag:
                class: 'mw-product__img',
                widths: '600, 900, 1200, 1600, 2000, 2400',
                sizes: '(min-width: 1200px) 60vw, 100vw',
                loading: 'eager',
                alt: media.alt
            }}
          </div>
        {%- else -%}
          <div class="mw-product__slide"></div>
        {%- endfor -%}
        {%- if product.media.size > 1 and section.settings.show_arrows -%}
          <button type="button" class="mw-product__nav mw-product__nav--prev" data-mw-media-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
            {% render 'mw-icon', name: 'chevron-left' %}
          </button>
          <button type="button" class="mw-product__nav mw-product__nav--next" data-mw-media-next aria-label="{{ 'general.slider.next_slide' | t }}">
            {% render 'mw-icon', name: 'chevron-right' %}
          </button>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 and section.settings.show_thumbnails -%}
        <ul class="mw-product__thumbs">
          {%- for media in product.media -%}
            <li>
              <button
                type="button"
                class="mw-product__thumb{% if media.id == featured_media_id %} is-active{% endif %}"
                data-mw-thumb="{{ media.id }}"
                aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
              >
                {%- if section.settings.media_backdrop == 'blur' -%}
                  {{ media.preview_image | image_url: width: 80 | image_tag: class: 'mw-product__backdrop', loading: 'lazy', alt: '', aria-hidden: 'true' }}
                {%- endif -%}
                {{
                  media.preview_image
                  | image_url: width: 600
                  | image_tag:
                    class: 'mw-product__thumb-img',
                    widths: '300, 450, 600',
                    sizes: '(min-width: 1200px) 15vw, 25vw',
                    loading: 'lazy',
                    alt: ''
                }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="mw-product__details">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="mw-product__blk mw-product__blk--app">{% render block %}</div>

          {%- when 'title' -%}
            <div class="mw-product__blk mw-product__blk--title" {{ block.shopify_attributes }}>
              <h1 class="mw-product__title">{{ product.title | escape }}</h1>
            </div>

          {%- when 'rating' -%}
            {%- liquid
              assign r_value = product.metafields.reviews.rating.value.rating | default: 0
              assign r_count = product.metafields.reviews.rating_count.value | default: 0
              assign r_round = r_value | round
            -%}
            {%- if r_count > 0 or block.settings.show_empty -%}
              <a href="#MwReviews-anchor" class="mw-product__blk mw-product__rating" {{ block.shopify_attributes }}>
                <span class="mw-product__rating-stars" role="img" aria-label="{{ r_value | round: 1 }} / 5">
                  {%- for i in (1..5) -%}
                    <span class="mw-star{% if i > r_round %} is-off{% endif %}"></span>
                  {%- endfor -%}
                </span>
                <span class="mw-product__rating-text">
                  {%- if r_count > 0 -%}
                    {{ r_value | round: 1 }} ({{ r_count }} {{ block.settings.reviews_label | escape }})
                  {%- else -%}
                    {{ block.settings.empty_label | escape }}
                  {%- endif -%}
                </span>
              </a>
            {%- endif -%}

          {%- when 'icon_text' -%}
            <ul class="mw-product__blk mw-product__features" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- liquid
                  assign img_key = 'image_' | append: i
                  assign txt_key = 'text_' | append: i
                  assign feature_image = block.settings[img_key]
                  assign feature_text = block.settings[txt_key]
                -%}
                {%- if feature_text != blank or feature_image != blank -%}
                  <li class="mw-product__feature">
                    {%- if feature_image != blank -%}
                      {{ feature_image | image_url: width: 120 | image_tag: class: 'mw-product__feature-icon', loading: 'lazy', alt: '' }}
                    {%- endif -%}
                    <span>{{ feature_text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'tutorial_link' -%}
            {%- liquid
              assign tutorial = product.metafields.custom.tutorials.value | first
              if tutorial == blank
                for t in shop.metaobjects.tutorials.values
                  for p in t.products.value
                    if p.id == product.id
                      assign tutorial = t
                      break
                    endif
                  endfor
                  if tutorial != blank
                    break
                  endif
                endfor
              endif
            -%}
            {%- if tutorial != blank or request.design_mode -%}
              <div class="mw-product__blk" data-mw-video {{ block.shopify_attributes }}>
                <button
                  type="button"
                  class="mw-video-trigger"
                  {% if tutorial != blank %}
                    data-mw-video-open
                  {% endif %}
                >
                  <span class="mw-video-trigger__icon" aria-hidden="true"></span>
                  <span class="mw-video-trigger__text">{{ block.settings.label | escape }}</span>
                  {%- liquid
                    assign t_duration = tutorial.duration.value
                    if tutorial == blank
                      assign t_duration = '2 min'
                    endif
                  -%}
                  {%- if block.settings.show_duration and t_duration != blank -%}
                    <span class="mw-video-trigger__duration">· {{ t_duration | escape }}</span>
                  {%- endif -%}
                </button>
                {%- if tutorial != blank -%}
                  <template data-mw-video-template>
                    {% render 'mw-tutorial-player', tutorial: tutorial, autoplay: true %}
                    <div class="mw-video-modal__caption">
                      <p class="mw-video-modal__title">{{ tutorial.title.value | escape }}</p>
                      {%- if tutorial.system.url != blank and block.settings.page_label != blank -%}
                        <a href="{{ tutorial.system.url }}" class="mw-video-modal__link">{{ block.settings.page_label | escape }}</a>
                      {%- endif -%}
                    </div>
                  </template>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="mw-product__blk mw-product__blk--price" {{ block.shopify_attributes }}>
              <p class="mw-product__price">
                <span data-mw-price>{{ variant.price | money_with_currency }}</span>
                <s class="mw-product__compare" data-mw-compare>
                  {%- if variant.compare_at_price > variant.price -%}
                    {{- variant.compare_at_price | money_with_currency -}}
                  {%- endif -%}
                </s>
              </p>
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="mw-product__blk mw-product__block" {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}
                  <h2 class="mw-product__label mw-product__label--dark">{{ block.settings.label | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.read_more -%}
                  <mw-read-more class="mw-read-more" data-lines="{{ block.settings.lines }}">
                    <div class="mw-product__description mw-read-more__content" id="MwDescription-{{ section.id }}">
                      {{ product.description }}
                    </div>
                    <button
                      type="button"
                      class="mw-read-more__toggle"
                      aria-expanded="false"
                      aria-controls="MwDescription-{{ section.id }}"
                      data-label-more="{{ block.settings.more_label | escape }}"
                      data-label-less="{{ block.settings.less_label | escape }}"
                      hidden
                    >
                      <span data-mw-read-more-label>{{ block.settings.more_label | escape }}</span>
                      {% render 'mw-icon', name: 'caret-down', class: 'mw-read-more__icon' %}
                    </button>
                  </mw-read-more>
                {%- else -%}
                  <div class="mw-product__description">{{ product.description }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              {%- assign swatch_lines = block.settings.swatch_map | newline_to_br | split: '<br />' -%}
              <div class="mw-product__blk mw-product__options" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign option_index = forloop.index0
                    assign option_name = option.name | downcase
                    assign is_color = false
                    if option_name contains 'color' or option_name contains 'colour'
                      assign is_color = true
                    endif
                  -%}
                  <div class="mw-product__block mw-product__option">
                    <p class="mw-product__label" id="MwOptionLabel-{{ section.id }}-{{ option.position }}">
                      {{- option.name | escape -}}
                    </p>
                    <div
                      class="mw-product__values"
                      role="radiogroup"
                      aria-labelledby="MwOptionLabel-{{ section.id }}-{{ option.position }}"
                    >
                      {%- for value in option.values -%}
                        {%- liquid
                          assign swatch_color = value.swatch.color
                          if swatch_color == blank and is_color
                            assign value_key = value | downcase | strip
                            for line in swatch_lines
                              assign pair = line | strip | split: ':'
                              assign pair_key = pair.first | downcase | strip
                              if pair_key == value_key
                                assign swatch_color = pair.last | strip
                              endif
                            endfor
                          endif
                        -%}
                        <label
                          class="mw-product__value{% if swatch_color != blank or value.swatch.image %} mw-product__value--swatch{% endif %}"
                          {% if swatch_color != blank %}
                            style="--swatch: {{ swatch_color }};"
                          {% elsif value.swatch.image %}
                            style="--swatch: url({{ value.swatch.image | image_url: width: 96 }}) center / cover;"
                          {% endif %}
                          title="{{ value | escape }}"
                        >
                          <input
                            type="radio"
                            class="visually-hidden"
                            name="MwOption-{{ section.id }}-{{ option.position }}"
                            value="{{ value | escape }}"
                            data-mw-option="{{ option_index }}"
                            {% if option.selected_value == value %}
                              checked
                            {% endif %}
                          >
                          <span class="mw-product__value-text">{{ value | escape }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div class="mw-product__blk mw-product__buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, class: 'mw-product__actions', data-mw-add: '' -%}
                <input type="hidden" name="id" value="{{ variant.id }}" data-mw-variant-id>
                {%- if block.settings.show_quantity -%}
                  <div class="mw-product__qty">
                    <button type="button" class="mw-product__qty-btn" data-mw-qty="-1" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">-</button>
                    <label class="visually-hidden" for="MwQty-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
                    <input
                      id="MwQty-{{ section.id }}"
                      class="mw-product__qty-input"
                      type="number"
                      name="quantity"
                      value="1"
                      min="1"
                      inputmode="numeric"
                    >
                    <button type="button" class="mw-product__qty-btn" data-mw-qty="1" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">+</button>
                  </div>
                {%- endif -%}
                <button
                  type="submit"
                  class="mw-product__add"
                  data-mw-add-button
                  data-label-add="{{ block.settings.add_to_cart_label | escape }}"
                  data-label-sold-out="{{ block.settings.sold_out_label | escape }}"
                  data-label-unavailable="{{ 'products.product.unavailable' | t | escape }}"
                  {% unless variant.available %}
                    disabled
                  {% endunless %}
                >
                  {%- if variant.available -%}
                    {{ block.settings.add_to_cart_label | escape }}
                  {%- else -%}
                    {{ block.settings.sold_out_label | escape }}
                  {%- endif -%}
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="mw-product__checkout" data-mw-checkout{% unless variant.available %} hidden{% endunless %}>
                    {{- form | payment_button -}}
                  </div>
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'divider' -%}
            <span class="mw-product__blk mw-product__divider" aria-hidden="true" {{ block.shopify_attributes }}></span>

          {%- when 'meta' -%}
            <dl class="mw-product__blk mw-product__meta" {{ block.shopify_attributes }}>
              {%- if block.settings.sku_label != blank -%}
                <div class="mw-product__meta-row">
                  <dt>{{ block.settings.sku_label | escape }}</dt>
                  <dd data-mw-sku>{{ variant.sku | default: '—' }}</dd>
                </div>
              {%- endif -%}
              {%- assign category = product.category.name | default: product.type -%}
              {%- if category != blank and block.settings.category_label != blank -%}
                <div class="mw-product__meta-row">
                  <dt>{{ block.settings.category_label | escape }}</dt>
                  <dd>{{ category | escape }}</dd>
                </div>
              {%- endif -%}
              {%- if product.tags.size > 0 and block.settings.tags_label != blank -%}
                <div class="mw-product__meta-row">
                  <dt>{{ block.settings.tags_label | escape }}</dt>
                  <dd>{{ product.tags | join: ', ' | escape }}</dd>
                </div>
              {%- endif -%}
              {%- if block.settings.share_label != blank -%}
                <div class="mw-product__meta-row">
                  <dt>{{ block.settings.share_label | escape }}</dt>
                  <dd class="mw-product__share">
                    {%- if block.settings.show_instagram -%}
                      <a
                        href="{{ block.settings.instagram_url | default: settings.social_instagram_link | default: '#' }}"
                        target="_blank"
                        rel="noopener"
                        aria-label="Instagram"
                      >
                        {% render 'mw-icon', name: 'instagram' %}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.show_facebook -%}
                      <a
                        href="https://www.facebook.com/sharer/sharer.php?u={{ request.origin | append: product.url | url_encode }}"
                        target="_blank"
                        rel="noopener"
                        aria-label="Facebook"
                      >
                        {% render 'mw-icon', name: 'facebook' %}
                      </a>
                    {%- endif -%}
                  </dd>
                </div>
              {%- endif -%}
            </dl>

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="mw-product__blk mw-product__text mw-product__text--{{ block.settings.style }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- endif -%}

          {%- when 'collapsible_tab' -%}
            <details class="mw-product__blk mw-product__tab" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="mw-product__tab-summary">
                <span class="mw-product__label mw-product__label--dark">{{ block.settings.heading | escape }}</span>
                {% render 'mw-icon', name: 'caret-down', class: 'mw-product__tab-caret' %}
              </summary>
              <div class="mw-product__tab-content mw-product__description">
                {{ block.settings.content }}
                {{ block.settings.page.content }}
              </div>
            </details>

          {%- when 'image' -%}
            {%- if block.settings.image != blank -%}
              <div class="mw-product__blk mw-product__image-block" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 1200px) 30vw, 100vw'
                }}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'custom_liquid' -%}
            <div class="mw-product__blk mw-product__custom" {{ block.shopify_attributes }}>
              {{ block.settings.custom_liquid }}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <script type="application/json" data-mw-variants>
      [
        {%- for v in product.variants -%}
          {%- liquid
            assign compare = ''
            if v.compare_at_price > v.price
              assign compare = v.compare_at_price | money_with_currency
            endif
          -%}
          {
            "id": {{ v.id }},
            "options": {{ v.options | json }},
            "available": {{ v.available | json }},
            "price": {{ v.price | money_with_currency | json }},
            "compare": {{ compare | json }},
            "sku": {{ v.sku | default: '—' | json }},
            "media": {{ v.featured_media.id | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
  </mw-product>
</section>

{% schema %}
{
  "name": "Meldwood product",
  "tag": "div",
  "class": "mw-product-section",
  "settings": [
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "default": true,
      "label": "Show image arrows"
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "default": true,
      "label": "Show thumbnails"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Main image",
      "default": "contain",
      "options": [
        {
          "value": "contain",
          "label": "Show the whole product"
        },
        {
          "value": "cover",
          "label": "Fill the frame (may crop)"
        }
      ]
    },
    {
      "type": "select",
      "id": "thumb_fit",
      "label": "Thumbnails",
      "default": "contain",
      "options": [
        {
          "value": "contain",
          "label": "Show the whole product"
        },
        {
          "value": "cover",
          "label": "Fill the frame (may crop)"
        }
      ]
    },
    {
      "type": "select",
      "id": "media_backdrop",
      "label": "Empty space around images",
      "default": "blur",
      "options": [
        {
          "value": "blur",
          "label": "Soft blurred photo"
        },
        {
          "value": "none",
          "label": "Plain background"
        }
      ],
      "info": "Fills the sides when \"Show the whole product\" leaves space."
    },
    {
      "type": "range",
      "id": "media_height",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 480,
      "label": "Main image height (desktop)",
      "info": "480 matches the design. Taller frames show upright products (chairs, stools) larger."
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "info": "Leave empty to use the theme color."
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "Extra space above"
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "Extra space below"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the star rating from your reviews app (Shopify's standard rating metafields)."
        },
        {
          "type": "text",
          "id": "reviews_label",
          "default": "reviews",
          "label": "Reviews label"
        },
        {
          "type": "checkbox",
          "id": "show_empty",
          "default": false,
          "label": "Show when there are no reviews"
        },
        {
          "type": "text",
          "id": "empty_label",
          "default": "No reviews yet",
          "label": "No reviews label"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Description",
          "label": "Label"
        },
        {
          "type": "checkbox",
          "id": "read_more",
          "default": true,
          "label": "Shorten long descriptions with Read more"
        },
        {
          "type": "range",
          "id": "lines",
          "min": 2,
          "max": 10,
          "step": 1,
          "default": 4,
          "label": "Lines to show"
        },
        {
          "type": "text",
          "id": "more_label",
          "default": "Read more",
          "label": "Read more label"
        },
        {
          "type": "text",
          "id": "less_label",
          "default": "Read less",
          "label": "Read less label"
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "swatch_map",
          "label": "Color swatches",
          "default": "Raw Birch: #EAD6C0\nWalnut: #513A2E\nBlack: #1C1C1C\nNatural: #D7B58F",
          "info": "One per line as Name: #hex. Used for Color options that have no swatch set in Shopify admin."
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Quantity and add to cart",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity",
          "default": true,
          "label": "Show quantity picker"
        },
        {
          "type": "text",
          "id": "add_to_cart_label",
          "default": "Add to Cart",
          "label": "Add to cart label"
        },
        {
          "type": "text",
          "id": "sold_out_label",
          "default": "Sold out",
          "label": "Sold out label"
        },
        {
          "type": "checkbox",

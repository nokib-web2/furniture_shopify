{{ 'mw-content.css' | asset_url | stylesheet_tag }}

<section
  class="mw mw-section mw-content"
  style="{% render 'mw-section-style', section: section %} --mw-text-width: {{ section.settings.max_width }};"
>
  <div class="mw-container mw-content__inner">
    {%- if section.settings.show_title -%}
      <div class="mw-page-header mw-page-header--{{ section.settings.alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="mw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="mw-heading mw-heading--display">{{ page.title | escape }}</h1>
      </div>
    {%- endif -%}
    {%- if page.content != blank -%}
      <div class="mw-page-body mw-rte{% if section.settings.alignment == 'center' %} mw-page-body--center{% endif %}">
        {{ page.content }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Meldwood page",
  "tag": "div",
  "class": "mw-main-page-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "default": true,
      "label": "Show page title"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1760,
      "step": 20,
      "unit": "px",
      "default": 880,
      "label": "Text width (desktop)"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "info": "Leave empty to use the theme color."
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "Extra space above"
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "Extra space below"
    }
  ]
}
{% endschema %}

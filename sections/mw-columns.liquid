{{ 'mw-content.css' | asset_url | stylesheet_tag }}

<section class="mw mw-section mw-content" style="{% render 'mw-section-style', section: section %}">
  <div class="mw-container mw-content__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="mw-columns__header mw-columns__header--{{ section.settings.heading_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="mw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mw-heading mw-heading--{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="mw-body">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="mw-columns__grid mw-columns--{{ section.settings.style }}"
      style="--mw-cols: {{ section.settings.columns }}; --mw-col-ratio: {{ section.settings.image_ratio }};"
    >
      {%- for block in section.blocks -%}
        <div class="mw-column{% if block.settings.link != blank %} mw-column--linked{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- if section.settings.image_style == 'icon' -%}
              {{
                block.settings.image
                | image_url: width: 200
                | image_tag: class: 'mw-column__icon', loading: 'lazy', widths: '100, 200', sizes: '56px'
              }}
            {%- else -%}
              <span class="mw-media mw-column__media">
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1200',
                    sizes: '(min-width: 1200px) 30vw, (min-width: 750px) 45vw, 100vw'
                }}
              </span>
            {%- endif -%}
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="mw-column__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="mw-column__text">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="mw-column__cover"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>
              <span class="visually-hidden">{{ block.settings.title | strip_html | default: block.settings.link_label | escape }}</span>
            </a>
            {%- if block.settings.link_label != blank -%}
              <a href="{{ block.settings.link }}" class="mw-arrow-link"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>
                <span>{{ block.settings.link_label | escape }}</span>
                {% render 'mw-icon', name: 'arrow-right' %}
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="mw-buttons" style="justify-content: center;">
        <a href="{{ section.settings.button_link | default: '#' }}" class="mw-button">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Meldwood columns",
  "tag": "div",
  "class": "mw-columns-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "large",
      "options": [
        { "value": "display", "label": "Display" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Column style",
      "default": "cards",
      "options": [
        { "value": "cards", "label": "Cards" },
        { "value": "plain", "label": "Plain" }
      ]
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Image style",
      "default": "photo",
      "options": [
        { "value": "photo", "label": "Photo" },
        { "value": "icon", "label": "Small icon" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Photo shape",
      "default": "4 / 3",
      "options": [
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "1", "label": "Square" },
        { "value": "3 / 4", "label": "Portrait" }
      ]
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Section style" },
    { "type": "color", "id": "section_bg", "label": "Background", "info": "Leave empty to use the theme color." },
    { "type": "range", "id": "space_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Extra space above" },
    { "type": "range", "id": "space_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Extra space below" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "inline_richtext", "id": "title", "default": "Column", "label": "Title" },
        { "type": "richtext", "id": "text", "default": "<p>Pair text with an image to focus on a product, collection or story.</p>", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link", "info": "Makes the whole column clickable." },
        { "type": "checkbox", "id": "new_tab", "default": false, "label": "Open link in a new tab" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Meldwood columns",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}

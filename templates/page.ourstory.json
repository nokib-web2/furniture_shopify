    "image_with_text_7bHfqH": {
      "type": "mw-image-text",
      "blocks": {
        "heading_wnatbY": {
          "type": "heading",
          "settings": {
            "heading": "Small <em>workshop.</em> No shortcuts.",
            "size": "large"
          }
        },
        "text_bHGgJq": {
          "type": "text",
          "settings": {
            "text": "<p>We're not a warehouse operation. Every piece of Meldwood furniture is cut on a CNC machine, hand-sanded, quality-checked, and packed by a small team right here in Pakistan.</p><p>That short supply chain means fewer emissions, less waste, and direct quality control. If a sheet of plywood doesn't meet our standards, it never becomes a product. Simple as that.</p>"
          }
        }
      },

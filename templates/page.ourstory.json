    "collapsible_content_VHYXqq": {
      "type": "mw-faq",
      "blocks": {
        "collapsible_row_kYFhn9": {
          "type": "question",
          "settings": {
            "question": "What is Meldwood  furniture?",
            "answer": "<p>Meldwood is a Pakistan based furniture brand that makes tool-free, flat-pack pieces from real Baltic-birch plywood. Every piece ships raw and assembles in about two minutes using an interlocking joint system, no screws, no hardware, no instructions.</p>",
            "page": ""
          }
        },
        "collapsible_row_b7D69p": {
          "type": "question",
          "settings": {
            "question": "Why is Meldwood furniture sold unfinished?",
            "answer": "<p>Because the \"right\" finish is whatever fits your space. Shipping raw means no factory paint, no mystery coatings, and no off-gassing chemicals. You can stain it, paint it, or leave it completely natural. Same piece, a thousand different homes.</p>",
            "page": ""
          }
        },
        "collapsible_row_6ETUYc": {
          "type": "question",
          "settings": {
            "question": "Does Meldwood furniture need tools to assemble?",
            "answer": "<p>No. Every Meldwood piece uses an interlocking joint system that slides together in under two minutes. No screws, no Allen wrenches, no cam locks. Disassembly works the same way, so your furniture moves with you.</p>",
            "page": ""
          }
        },
        "collapsible_row_XGRCTb": {
          "type": "question",
          "settings": {
            "question": "What is Meldwood furniture made of?",
            "answer": "<p>Furniture-grade plywood, the same cross-laminated material used in speaker cabinets and museum fixtures. Unlike particleboard or MDF, it won't swell, warp, or sag. The grain is visible throughout the edges, which is part of the look.</p>",
            "page": ""
          }
        },
        "collapsible_row_ECW4QA": {
          "type": "question",
          "disabled": true,
          "settings": {
            "question": "Is UNFNSHED furniture made in the Pakistan?",
            "answer": "<p>Yes. Every piece is CNC-cut, hand-sanded, quality-checked, and packed in our small workshop in Rawalpindi. No overseas factories and no middlemen.</p>",
            "page": ""
          }
        },
        "collapsible_row_wpYKd8": {
          "type": "question",
          "settings": {
            "question": "Who founded Meldwood?",
            "answer": "<p>Meldwood was founded by Syed Wasi, who started the company to prove that well-made furniture doesn't need tools, particleboard, or a pre-picked color. The team is small and operates out of a single Rawalpindi.</p>",
            "page": ""
          }
        },
        "collapsible_row_BdFKiN": {
          "type": "question",
          "settings": {
            "question": "Does Meldowod offer free shipping and returns?",
            "answer": "<p>Free shipping on orders over 25,000 within the Pakistan, and a 7-day return window if a piece isn't right for your space. Because everything ships flat-pack, returns are painless.</p>",
            "page": ""
          }
        },
        "collapsible_row_XmR6ah": {
          "type": "question",
          "settings": {
            "question": "Can I see how other customers have finished their Meldwood pieces?",
            "answer": "<p>Yes — our custom er creations gallery has walnut stains, chalk paint, kid-drawn stools, and plenty of raw builds. Real homes, real finishes, no stylists.</p>",
            "page": ""
          }
        }
      },

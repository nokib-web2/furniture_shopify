{% comment %}
  Meldwood landing product card (image, title, price).

  Accepts:
  - product: {Object} Product Liquid object
  - style: {String} 'featured' (large) or 'compact' (best sellers)
  - sizes: {String} Image sizes attribute

  Usage:
  {% render 'mw-product-card', product: product, style: 'featured', sizes: '(min-width: 1200px) 30vw, 100vw' %}
{% endcomment %}
<a href="{{ product.url }}" class="mw-card mw-card--{{ style | default: 'featured' }}">
  <span class="mw-card__media">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 1400
        | image_tag:
          loading: 'lazy',
          sizes: sizes,
          widths: '360, 540, 720, 900, 1100, 1400',
          class: 'mw-card__img',
          alt: product.featured_media.alt
      }}
    {%- endif -%}
  </span>
  <span class="mw-card__info">
    <span class="mw-card__title">{{ product.title | escape }}</span>
    <span class="mw-card__price">{{ product.price | money_with_currency }}</span>
  </span>
</a>

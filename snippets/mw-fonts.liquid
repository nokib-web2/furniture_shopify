{% comment %}
  Meldwood design tokens. Every value comes from Theme settings → Meldwood colors /
  Meldwood fonts / Meldwood buttons & cards, so nothing below is hardcoded.
{% endcomment %}
{%- liquid
  assign font_heading = settings.mw_font_heading | default: 'Bricolage Grotesque' | strip
  assign font_body = settings.mw_font_body | default: 'Outfit' | strip
  if settings.mw_fonts_url != blank
    assign fonts_url = settings.mw_fonts_url | strip
  else
    assign heading_family = font_heading | replace: ' ', '+'
    assign body_family = font_body | replace: ' ', '+'
    assign fonts_url = 'https://fonts.googleapis.com/css2?family=' | append: heading_family | append: ':wght@400;500;600;700&family=' | append: body_family | append: ':wght@400;500;600;700&display=swap'
  endif
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ fonts_url | escape }}">
{{ 'mw-base.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign text_scale = settings.mw_text_scale | default: 100 | divided_by: 100.0
-%}
<style>
  :root {
    --mw-bg: {{ settings.mw_color_bg | default: '#F5F3ED' }};
    --mw-panel: {{ settings.mw_color_panel | default: '#FFFFFF' }};
    --mw-surface: {{ settings.mw_color_surface | default: '#FCFAF6' }};
    --mw-surface-alt: {{ settings.mw_color_surface_alt | default: '#EFECE4' }};
    --mw-soft: {{ settings.mw_color_soft | default: '#F5F5F7' }};
    --mw-placeholder: {{ settings.mw_color_placeholder | default: '#E9E5DC' }};
    --mw-footer-bg: {{ settings.mw_color_footer | default: '#FAFAFA' }};
    --mw-ink: {{ settings.mw_color_ink | default: '#121212' }};
    --mw-ink-soft: {{ settings.mw_color_ink_soft | default: '#3A3B3C' }};
    --mw-muted: {{ settings.mw_color_muted | default: '#5C5A56' }};
    --mw-secondary: {{ settings.mw_color_secondary | default: '#666666' }};
    --mw-subtle: {{ settings.mw_color_subtle | default: '#999999' }};
    --mw-dark: {{ settings.mw_color_dark | default: '#171818' }};
    --mw-on-dark: {{ settings.mw_color_on_dark | default: '#FFFFFF' }};
    --mw-tan: {{ settings.mw_color_accent | default: '#B08A5E' }};
    --mw-line: {{ settings.mw_color_line | default: '#B09778' }};
    --mw-border: {{ settings.mw_color_border | default: '#E5E5EA' }};
    --mw-active: {{ settings.mw_color_active | default: '#DADADA' }};
    --mw-badge: {{ settings.mw_color_badge | default: '#FF3B30' }};
    --mw-star: {{ settings.mw_color_star | default: '#FF9500' }};

    --mw-font-display: '{{ font_heading }}', sans-serif;
    --mw-font-body: '{{ font_body }}', sans-serif;
    --mw-font-ui: var(--mw-font-body);
    --mw-font-card: var(--mw-font-body);
    --mw-font-serif: var(--mw-font-display);

    --mw-ts: {{ text_scale }};
    --mw-btn-radius: {{ settings.mw_button_radius | default: 32 }}px;
  }
</style>
